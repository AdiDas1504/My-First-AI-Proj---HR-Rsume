# Copy to .env.local and fill in. Never commit real values.
# With nothing filled in, the site runs locally in demo mode.

# Public address of the site (used for links and redirects)
APP_URL=http://localhost:3000

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Only for a private preview deployment: allows on-screen login codes and
# simulated payments in production. NEVER set this on the real public site.
# DEMO_MODE=1

# Password-protects the whole site (browser login prompt). Use it together with
# DEMO_MODE=1 on a private preview so strangers can't spend your AI budget.
# PREVIEW_PASSWORD=

# --- Claude (resume analysis and tailoring) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL_TAILOR=claude-sonnet-5-5
# CLAUDE_MODEL_SCAN=claude-haiku-5-5

# --- Supabase (database). Server-only secret key (sb_secret_...): never expose it ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- SMS login codes: "console" (demo) or "twilio" ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payments: only "demo" exists today (see src/lib/billing.ts) ---
PAYMENT_PROVIDER=demo

# Owner dashboard (/admin): mobile numbers allowed in, comma-separated.
ADMIN_PHONES=
# Optional: key for hashing phone numbers in the free-check list. Set it to the
# current SESSION_SECRET before rotating SESSION_SECRET.
PHONE_HASH_SECRET=
